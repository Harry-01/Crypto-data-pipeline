# ---- Databricks (Free Edition works) ----
# Workspace URL, e.g. https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token: Settings > Developer > Access tokens
DATABRICKS_TOKEN=
# SQL warehouse > Connection details > HTTP path, e.g. /sql/1.0/warehouses/abc123
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=workspace
RAW_SCHEMA=crypto_raw
LANDING_VOLUME=landing
# dbt builds <DBT_SCHEMA>_bronze / _silver / _gold
DBT_SCHEMA=crypto

# ---- Sources ----
# Free demo key from https://www.coingecko.com/en/developers/dashboard (optional but recommended)
COINGECKO_API_KEY=
COIN_LIMIT=30
# Optional override: NEWS_FEEDS=coindesk=https://...,decrypt=https://...
NEWS_FEEDS=

# Reddit "script" app credentials. New apps need Reddit approval, so this source is optional.
ENABLE_REDDIT=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=crypto-data-pipeline/1.0 by <your_reddit_username>
MAX_PAGES=3
